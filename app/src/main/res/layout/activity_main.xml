<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="2800dp"
    android:background="@color/teal_700"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="2800dp"
        android:orientation="vertical"
        tools:context=".MainActivity">


        <FrameLayout
            android:id="@+id/zone1"
            android:layout_width="wrap_content"
            android:layout_height="170dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/imageView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/image"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/potager" />

            <TextView
                android:id="@+id/resultat1"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:background="@color/teal_400"
                android:paddingLeft="4dp"
                android:paddingBottom="5dp"
                android:text="@string/programmer_le_potager"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </FrameLayout>


        <FrameLayout
            android:id="@+id/zone2"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="4dp">


            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/image"
                android:scaleType="centerCrop"
                android:src="@drawable/parking" />

            <TextView
                android:id="@+id/resultat2"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:background="@color/teal_400"
                android:paddingLeft="4dp"
                android:paddingBottom="5dp"
                android:text="@string/programmer_le_parking"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </FrameLayout>


        <FrameLayout
            android:id="@+id/zone3"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="4dp">


            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/image"
                android:scaleType="centerCrop"
                android:src="@drawable/portillon" />

            <TextView
                android:id="@+id/resultat3"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:background="@color/teal_400"
                android:paddingLeft="4dp"
                android:paddingBottom="5dp"
                android:text="@string/programmer_le_portillon"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </FrameLayout>


        <FrameLayout
            android:id="@+id/zone4"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/image"
                android:scaleType="centerCrop"
                android:src="@drawable/grandtour"
                />


            <TextView
                android:id="@+id/resultat4"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:background="@color/teal_400"
                android:paddingLeft="4dp"
                android:paddingBottom="5dp"
                android:text="@string/programmer_le_grand_tour"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </FrameLayout>
<TextView
    android:id="@+id/heure"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:text="ESP32 heure : "
    android:textColor="@color/white"
/>
    </LinearLayout>
</ScrollView>